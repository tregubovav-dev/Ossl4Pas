{
  "root": "Z:\\Projects\\Embarcadero\\Delphi\\Libs\\projects\\Ossl4Pas",
  "output_root": "CI\\manual",
  "git_path": "git", 
  "clean_on_success": false,
  "default_config": "Debug",
  "default_compilers": ["10.4.2","13.1"],  

  "dcc": {
    "10.4.2": { 
      "path": "C:\\Program Files (x86)\\Embarcadero\\Studio\\21.0\\bin\\rsvars.bat", 
      "active": true,
      "variables": {
        "dcc_suffix": "D10_4"
      }
    },
    "13.1": { 
      "path": "C:\\Program Files (x86)\\Embarcadero\\Studio\\37.0\\bin\\rsvars.bat", 
      "active": true,
      "variables": {
        "dcc_suffix": "D13_1"
      }
    }
  },

  "platforms": ["Win32", "Win64", "Linux64", "OSX64"],

  "execution_profiles": {
    "Win64": { "type": "local" },
    "Win32": { "type": "local" },
    "Linux64": { 
      "type": "wsl", 
      "distribution": "CI", 
      "path_mapping": { "Y:\\": "/mnt/Y/" },
      "work_dir": "/tmp/ossl4pas_tests"
    },
    "OSX64": { 
      "type": "ssh", 
      "host": "mac.local", 
      "user": "ci", 
      "identity_file": ".secrets\\id-ed25519",
      "remote_root": "/tmp/CI/Ossl4Pas/",
      "path_mapping": { "Y:\\Ossl4Pas\\": "/tmp/CI/Ossl4Pas/"}
    }
  },

  "build_options": {
    "common": {
      "env_vars": {
        "FASTMM5": "..\\FastMM5",
        "DUnitX": "..\\DUnitX\\Source"
      },
      "defines": [
        "CI",
        "UNITTEST",
        "EnableMemoryLeakReporting",
        "FastMM_NoMessageBoxes"
      ]
    },
    "Debug": {
      "search_paths": [],
      "defines": ["Debug"]
    },
    "Release": {
      "search_paths": [],
      "defines": ["Release"]
    }
  },

  "dependencies": {
    "openssl_root": "lib\\openssl\\{version}\\{platform}",
    "openssl_versions": ["3.0.19", "3.6.1"]
  },

  "common_params": {
    "-b": "",
    "-cm": "Quiet",
    "-mkw": "{output_dir}\\Temp",
    "-xml": "{output_dir}\\{project_name}_results.xml"
  },

  "projects": [
    { 
      "name": "Ossl4Pas_Package", 
      "path": "Packages\\{dcc_suffix}\\Ossl4Pas_rt.dproj", 
      "type": "package",
      "tags": ["core", "build_only"],
      "env_vars": {}
    },
    {
      "name": "Mock_Library",
      "path": "Tests\\Mocks\\mockLibs\\mocklib.dproj",
      "tags": ["core", "fast"],
      "env_vars": {}
    },
    { 
      "name": "Test_Loader", 
      "path": "Tests\\TOsslLoader\\Ossl4PasLoader_UT.dproj", 
      "type": "test",
      "tags": ["core", "tests", "fast"],
      "params": {
        "-mkl": "{output_dir}\\{lib_prefix}mocklib{lib_ext}"
      },
      "env_vars": {}
    },
    { 
      "name": "Test_Errors", 
      "path": "Tests\\TOsslErrors\\Ossl4PasErrors_UT.dproj", 
      "type": "test",
      "tags": ["core", "tests", "fast"],
      "params": {
        "-mkl": "{output_dir}\\{lib_prefix}mocklib{lib_ext}"
      },
      "env_vars": {}
    },
    { 
      "name": "Test_API", 
      "path": "Tests\\Ossl4PasApi\\Ossl4PasApi_UT.dproj", 
      "type": "test",
      "tags": ["tests", "slow", "integration"],
      "matrix": true,
      "params": {},
      "env_vars": {}
    }
  ]
}